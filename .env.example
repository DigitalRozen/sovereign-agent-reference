# Copy to .env and fill in values. Never commit .env.
# Every key here must stay empty in this file (enforced by tests/test_repo_hygiene.py).

# LLM provider behind the gateway. Leave empty to run against the built-in deterministic model.
# When set, `make up` stores it in the cluster and the gateway model `agent-openrouter` becomes usable.
# The OpenRouter model name is set in deploy/base/litellm/config.yaml.
OPENROUTER_API_KEY=

# Optional: Telegram approval channel (stretch goal). Leave empty to use the web approval UI only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=
